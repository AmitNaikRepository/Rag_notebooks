   "source": [
    "## 🎯 Step 5: Use Fine-Tuned Model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def compare_models(\n",
    "    base_model: str,\n",
    "    fine_tuned_model: str,\n",
    "    test_query: str,\n",
    "    system_prompt: str = None\n",
    "):\n",
    "    \"\"\"Compare base vs fine-tuned model.\"\"\"\n",
    "    \n",
    "    print(f\"🔍 Test Query: {test_query}\\n\")\n",
    "    print(\"=\"*60)\n",
    "    \n",
    "    # Base model (with long prompt)\n",
    "    messages_base = []\n",
    "    if system_prompt:\n",
    "        messages_base.append({\n",
    "            \"role\": \"system\",\n",
    "            \"content\": system_prompt\n",
    "        })\n",
    "    messages_base.append({\n",
    "        \"role\": \"user\",\n",
    "        \"content\": test_query\n",
    "    })\n",
    "    \n",
    "    response_base = client.chat.completions.create(\n",
    "        model=base_model,\n",
    "        messages=messages_base,\n",
    "        temperature=0.7\n",
    "    )\n",
    "    \n",
    "    # Fine-tuned model (short prompt)\n",
    "    messages_ft = [{\"role\": \"user\", \"content\": test_query}]\n",
    "    \n",
    "    response_ft = client.chat.completions.create(\n",
    "        model=fine_tuned_model,\n",
    "        messages=messages_ft,\n",
    "        temperature=0.7\n",
    "    )\n",
    "    \n",
    "    # Display results\n",
    "    print(f\"\\n📊 Base Model ({base_model}):\")\n",
    "    print(f\"   Prompt tokens: {response_base.usage.prompt_tokens}\")\n",
    "    print(f\"   Response: {response_base.choices[0].message.content[:200]}...\")\n",
    "    \n",
    "    print(f\"\\n✨ Fine-Tuned Model:\")\n",
    "    print(f\"   Prompt tokens: {response_ft.usage.prompt_tokens}\")\n",
    "    print(f\"   Response: {response_ft.choices[0].message.content[:200]}...\")\n",
    "    \n",
    "    # Savings\n",
    "    token_reduction = response_base.usage.prompt_tokens - response_ft.usage.prompt_tokens\n",
    "    print(f\"\\n💰 Token Savings: {token_reduction} tokens ({token_reduction/response_base.usage.prompt_tokens*100:.1f}%)\")\n",
    "\n",
    "# Example usage (simulated)\n",
    "print(\"💡 Using Fine-Tuned Model:\\n\")\n",
    "print(\"\"\"\n",
    "# Simple inference\n",
    "response = client.chat.completions.create(\n",
    "    model=\"ft:gpt-3.5-turbo:company:customer-support-v1:abc123\",\n",
    "    messages=[\n",
    "        {\"role\": \"user\", \"content\": \"How do I track my order?\"}\n",
    "    ]\n",
    ")\n",
    "\n",
    "print(response.choices[0].message.content)\n",
    "\"\"\")\n",
    "\n",
    "print(\"\\n📊 Comparison Example:\")\n",
    "print(\"\"\"\n",
    "compare_models(\n",
    "    base_model=\"gpt-3.5-turbo\",\n",
    "    fine_tuned_model=\"ft:gpt-3.5-turbo:company:customer-support-v1:abc123\",\n",
    "    test_query=\"I need to return my order\",\n",
    "    system_prompt=\"You are a helpful customer support agent for TechCo. Respond professionally and concisely.\"\n",
    ")\n",
    "\"\"\")"
   ]
  },
