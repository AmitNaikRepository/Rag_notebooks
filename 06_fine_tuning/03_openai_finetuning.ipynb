    "## 🏗️ Step 3: Create Fine-Tuning Job"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def create_finetuning_job(\n",
    "    training_file_id: str,\n",
    "    model: str = \"gpt-3.5-turbo\",\n",
    "    suffix: str = None,\n",
    "    hyperparameters: Dict = None\n",
    ") -> str:\n",
    "    \"\"\"Create a fine-tuning job.\"\"\"\n",
    "    \n",
    "    print(f\"🏗️  Creating fine-tuning job...\")\n",
    "    print(f\"   Base model: {model}\")\n",
    "    \n",
    "    params = {\n",
    "        \"training_file\": training_file_id,\n",
    "        \"model\": model,\n",
    "    }\n",
    "    \n",
    "    if suffix:\n",
    "        params[\"suffix\"] = suffix\n",
    "    \n",
    "    if hyperparameters:\n",
    "        params[\"hyperparameters\"] = hyperparameters\n",
    "    \n",
    "    response = client.fine_tuning.jobs.create(**params)\n",
    "    \n",
    "    job_id = response.id\n",
    "    print(f\"✅ Job created: {job_id}\")\n",
    "    print(f\"   Status: {response.status}\")\n",
    "    \n",
    "    return job_id\n",
    "\n",
    "# Example configuration\n",
    "print(\"📝 Fine-Tuning Configuration:\")\n",
    "print(\"\"\"\\n# Basic fine-tuning\ncreate_finetuning_job(\n",
    "    training_file_id=training_file_id,\n",
    "    model=\"gpt-3.5-turbo\",\n",
    "    suffix=\"customer-support-v1\"\n",
    ")\n",
    "\n",
    "# With hyperparameters\n",
    "create_finetuning_job(\n",
    "    training_file_id=training_file_id,\n",
    "    model=\"gpt-3.5-turbo\",\n",
    "    suffix=\"customer-support-v1\",\n",
    "    hyperparameters={\n",
    "        \"n_epochs\": 3,  # Number of training epochs\n",
    "        \"batch_size\": 1,  # Auto or 1, 2, 4, 8\n",
    "        \"learning_rate_multiplier\": 1.0  # Default is auto\n",
    "    }\n",
    ")\n",
    "\"\"\")\n",
    "\n",
    "# Uncomment to create job:\n",
    "# job_id = create_finetuning_job(\n",
    "#     training_file_id=training_file_id,\n",
    "#     model=\"gpt-3.5-turbo\",\n",
    "#     suffix=\"customer-support-v1\"\n",
    "# )\n",
    "\n",
    "# Simulated job ID for demo\n",
    "job_id = \"ftjob-demo123\"\n",
    "print(f\"\\n💡 Demo job ID: {job_id}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 📊 Step 4: Monitor Training Progress"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "def monitor_finetuning_job(job_id: str, poll_interval: int = 30):\n",
    "    \"\"\"Monitor fine-tuning job progress.\"\"\"\n",
    "    \n",
    "    print(f\"📊 Monitoring job: {job_id}\\n\")\n",
    "    \n",
    "    while True:\n",
    "        job = client.fine_tuning.jobs.retrieve(job_id)\n",
    "        \n",
    "        status = job.status\n",
    "        print(f\"Status: {status}\")\n",
    "        \n",
    "        # Show progress if available\n",
    "        if hasattr(job, 'trained_tokens') and job.trained_tokens:\n",
    "            print(f\"Trained tokens: {job.trained_tokens}\")\n",
    "        \n",
    "        # Check if completed\n",
    "        if status == 'succeeded':\n",
    "            print(f\"\\n✅ Training completed!\")\n",
    "            print(f\"   Fine-tuned model: {job.fine_tuned_model}\")\n",
    "            return job.fine_tuned_model\n",
    "        \n",
    "        elif status == 'failed':\n",
    "            print(f\"\\n❌ Training failed!\")\n",
    "            if hasattr(job, 'error'):\n",
    "                print(f\"   Error: {job.error}\")\n",
    "            return None\n",
    "        \n",
    "        elif status == 'cancelled':\n",
    "            print(f\"\\n⚠️  Training cancelled\")\n",
    "            return None\n",
    "        \n",
    "        # Still running, wait and check again\n",
    "        print(f\"Waiting {poll_interval}s...\\n\")\n",
    "        time.sleep(poll_interval)\n",
    "\n",
    "def get_job_events(job_id: str, limit: int = 10):\n",
    "    \"\"\"Get training events/logs.\"\"\"\n",
    "    \n",
    "    events = client.fine_tuning.jobs.list_events(\n",
    "        fine_tuning_job_id=job_id,\n",
    "        limit=limit\n",
    "    )\n",
    "    \n",
    "    print(f\"📋 Recent Events:\\n\")\n",
    "    for event in events.data:\n",
    "        print(f\"  [{event.created_at}] {event.message}\")\n",
    "\n",
    "# Example: Check job status\n",
    "def check_job_status(job_id: str):\n",
    "    \"\"\"Quick status check.\"\"\"\n",
    "    \n",
    "    job = client.fine_tuning.jobs.retrieve(job_id)\n",
    "    \n",
    "    print(f\"Job ID: {job.id}\")\n",
    "    print(f\"Status: {job.status}\")\n",
    "    print(f\"Model: {job.model}\")\n",
    "    \n",
    "    if job.fine_tuned_model:\n",
    "        print(f\"Fine-tuned model: {job.fine_tuned_model}\")\n",
    "    \n",
    "    if hasattr(job, 'trained_tokens') and job.trained_tokens:\n",
    "        print(f\"Trained tokens: {job.trained_tokens}\")\n",
    "\n",
    "print(\"💡 Monitoring Functions:\")\n",
    "print(\"\"\"\n",
    "# Wait for completion\n",
    "model_id = monitor_finetuning_job(job_id)\n",
    "\n",
    "# Quick status check\n",
    "check_job_status(job_id)\n",
    "\n",
    "# View training logs\n",
    "get_job_events(job_id)\n",
    "\"\"\")\n",
    "\n",
    "# Simulated model ID\n",
    "fine_tuned_model = \"ft:gpt-3.5-turbo:company:customer-support-v1:abc123\"\n",
    "print(f\"\\n✅ Demo fine-tuned model: {fine_tuned_model}\")"
   ]
  },
