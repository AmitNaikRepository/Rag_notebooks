   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 💰 Cost Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class FineTuningCostCalculator:\n",
    "    \"\"\"Calculate fine-tuning costs.\"\"\"\n",
    "    \n",
    "    # Pricing (as of 2024)\n",
    "    TRAINING_COST_PER_1K_TOKENS = {\n",
    "        \"gpt-3.5-turbo\": 0.008,\n",
    "        \"gpt-4o-mini\": 0.002,\n",
    "        \"babbage-002\": 0.0004,\n",
    "    }\n",
    "    \n",
    "    INFERENCE_COST_PER_1K_TOKENS = {\n",
    "        \"gpt-3.5-turbo\": {\"input\": 0.0015, \"output\": 0.002},\n",
    "        \"gpt-3.5-turbo-ft\": {\"input\": 0.003, \"output\": 0.006},\n",
    "    }\n",
    "    \n",
    "    @staticmethod\n",
    "    def training_cost(\n",
    "        num_examples: int,\n",
    "        avg_tokens_per_example: int,\n",
    "        num_epochs: int,\n",
    "        model: str = \"gpt-3.5-turbo\"\n",
    "    ) -> float:\n",
    "        \"\"\"Calculate training cost.\"\"\"\n",
    "        \n",
    "        total_tokens = num_examples * avg_tokens_per_example * num_epochs\n",
    "        cost_per_1k = FineTuningCostCalculator.TRAINING_COST_PER_1K_TOKENS[model]\n",
    "        \n",
    "        cost = (total_tokens / 1000) * cost_per_1k\n",
    "        \n",
    "        return cost\n",
    "    \n",
    "    @staticmethod\n",
    "    def inference_savings(\n",
    "        base_prompt_tokens: int,\n",
    "        ft_prompt_tokens: int,\n",
    "        requests_per_day: int,\n",
    "        days: int = 30\n",
    "    ) -> Dict:\n",
    "        \"\"\"Calculate inference cost savings.\"\"\"\n",
    "        \n",
    "        base_costs = FineTuningCostCalculator.INFERENCE_COST_PER_1K_TOKENS[\"gpt-3.5-turbo\"]\n",
    "        ft_costs = FineTuningCostCalculator.INFERENCE_COST_PER_1K_TOKENS[\"gpt-3.5-turbo-ft\"]\n",
    "        \n",
    "        total_requests = requests_per_day * days\n",
    "        \n",
    "        # Base model cost\n",
    "        base_cost = (base_prompt_tokens / 1000) * base_costs[\"input\"] * total_requests\n",
    "        \n",
    "        # Fine-tuned model cost\n",
    "        ft_cost = (ft_prompt_tokens / 1000) * ft_costs[\"input\"] * total_requests\n",
    "        \n",
    "        savings = base_cost - ft_cost\n",
    "        \n",
    "        return {\n",
    "            'base_cost': base_cost,\n",
    "            'ft_cost': ft_cost,\n",
    "            'savings': savings,\n",
    "            'savings_pct': (savings / base_cost * 100) if base_cost > 0 else 0\n",
    "        }\n",
    "\n",
    "# Example cost calculation\n",
    "print(\"💰 Cost Analysis\\n\")\n",
    "print(\"=\"*60)\n",
    "\n",
    "# Training cost\n",
    "train_cost = FineTuningCostCalculator.training_cost(\n",
    "    num_examples=1000,\n",
    "    avg_tokens_per_example=200,\n",
    "    num_epochs=3,\n",
    "    model=\"gpt-3.5-turbo\"\n",
    ")\n",
    "\n",
    "print(f\"Training Cost:\")\n",
    "print(f\"  Dataset: 1,000 examples\")\n",
    "print(f\"  Tokens per example: 200\")\n",
    "print(f\"  Epochs: 3\")\n",
    "print(f\"  Total cost: ${train_cost:.2f}\\n\")\n",
    "\n",
    "# Inference savings\n",
    "savings = FineTuningCostCalculator.inference_savings(\n",
    "    base_prompt_tokens=500,  # With long system prompt\n",
    "    ft_prompt_tokens=50,     # Fine-tuned (no system prompt needed)\n",
    "    requests_per_day=1000,\n",
    "    days=30\n",
    ")\n",
    "\n",
    "print(f\"Monthly Inference (30 days, 1,000 requests/day):\")\n",
    "print(f\"  Base model cost: ${savings['base_cost']:.2f}\")\n",
    "print(f\"  Fine-tuned cost: ${savings['ft_cost']:.2f}\")\n",
    "print(f\"  Monthly savings: ${savings['savings']:.2f} ({savings['savings_pct']:.1f}%)\\n\")\n",
    "\n",
    "# Break-even analysis\n",
    "breakeven_days = train_cost / (savings['savings'] / 30) if savings['savings'] > 0 else float('inf')\n",
    "print(f\"📊 Break-even: {breakeven_days:.1f} days\")\n",
    "print(f\"   After {breakeven_days:.1f} days, you save money with fine-tuning!\")"
   ]
  },
  {
