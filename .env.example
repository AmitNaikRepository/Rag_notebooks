# ============================================================
# AI/LLM Engineer Learning Series - Environment Variables
# ============================================================
# 
# INSTRUCTIONS:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your actual API keys
# 3. NEVER commit .env to git (it's in .gitignore)
#
# ============================================================

# LLM API Keys
# ------------------------------------------------------------

# OpenAI API Key
# Get yours at: https://platform.openai.com/api-keys
# Cost: GPT-4: ~$0.03/1K tokens, GPT-3.5: ~$0.001/1K tokens
OPENAI_API_KEY=sk-your-openai-key-here

# Anthropic API Key (Claude)
# Get yours at: https://console.anthropic.com/
# Cost: Claude 3.5 Sonnet: ~$0.003/1K tokens
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# Groq API Key (Fast inference)
# Get yours at: https://console.groq.com/
# Cost: Free tier available, very fast!
GROQ_API_KEY=gsk_your-groq-key-here

# Hugging Face API Token (Optional)
# Get yours at: https://huggingface.co/settings/tokens
# Used for downloading models and datasets
HUGGINGFACE_TOKEN=hf_your-huggingface-token-here

# Cohere API Key (Optional)
# Get yours at: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your-cohere-key-here


# Vector Database Credentials
# ------------------------------------------------------------

# Qdrant (Optional - for cloud deployment)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=your-qdrant-key-here

# Pinecone (Optional)
PINECONE_API_KEY=your-pinecone-key-here
PINECONE_ENVIRONMENT=your-environment


# Database Credentials
# ------------------------------------------------------------

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=llm_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-postgres-password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# MongoDB (Optional)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=llm_dev


# Observability & Monitoring
# ------------------------------------------------------------

# Langfuse (LLM Tracing)
# Get yours at: https://cloud.langfuse.com/
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Sentry (Error Tracking - Optional)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id


# Cloud Provider Credentials
# ------------------------------------------------------------

# AWS
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=your-bucket-name

# Google Cloud (Optional)
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
GCP_PROJECT_ID=your-project-id


# Application Settings
# ------------------------------------------------------------

# Environment
ENVIRONMENT=development  # development, staging, production

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Caching
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_FORMAT=json  # json, text


# Security
# ------------------------------------------------------------

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-super-secret-jwt-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60

# API Key for your application
API_SECRET_KEY=your-application-api-key


# Feature Flags
# ------------------------------------------------------------

ENABLE_STREAMING=true
ENABLE_FUNCTION_CALLING=true
ENABLE_EMBEDDINGS_CACHE=true
ENABLE_OBSERVABILITY=true


# Model Configuration
# ------------------------------------------------------------

# Default models to use
DEFAULT_LLM_MODEL=gpt-3.5-turbo
DEFAULT_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-12-v2

# Model parameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_MAX_TOKENS=1000
DEFAULT_TOP_P=0.9


# Cost Tracking
# ------------------------------------------------------------

# Set budget alerts (in USD)
MONTHLY_BUDGET_LIMIT=100.00
DAILY_BUDGET_LIMIT=10.00
ALERT_EMAIL=your-email@example.com


# ============================================================
# IMPORTANT SECURITY NOTES:
#
# 1. NEVER commit .env file to version control
# 2. Use different API keys for dev/staging/production
# 3. Rotate keys regularly
# 4. Use environment-specific configurations
# 5. Enable billing alerts on provider dashboards
# 6. Monitor API usage daily
#
# ============================================================
