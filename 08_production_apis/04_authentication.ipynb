   "source": [
    "## 🔒 Security Best Practices"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(\"\"\"\n",
    "# Security Best Practices\n",
    "\n",
    "## 1. Store Secrets Securely\n",
    "\n",
    "# ❌ BAD - Hardcoded\n",
    "SECRET_KEY = \"my-secret-key\"\n",
    "API_KEY = \"sk_abc123\"\n",
    "\n",
    "# ✅ GOOD - Environment variables\n",
    "import os\n",
    "SECRET_KEY = os.getenv(\"SECRET_KEY\")\n",
    "API_KEY = os.getenv(\"API_KEY\")\n",
    "\n",
    "# ✅ BETTER - Secrets manager\n",
    "from cloud_secrets import get_secret\n",
    "SECRET_KEY = get_secret(\"app/secret_key\")\n",
    "\n",
    "## 2. Hash Passwords\n",
    "\n",
    "# ❌ BAD - Plain text\n",
    "password = \"user_password\"\n",
    "\n",
    "# ✅ GOOD - Bcrypt\n",
    "from passlib.context import CryptContext\n",
    "pwd_context = CryptContext(schemes=[\"bcrypt\"], deprecated=\"auto\")\n",
    "hashed = pwd_context.hash(\"user_password\")\n",
    "\n",
    "## 3. Use HTTPS Only\n",
    "\n",
    "# Force HTTPS redirect\n",
    "from fastapi.middleware.httpsredirect import HTTPSRedirectMiddleware\n",
    "app.add_middleware(HTTPSRedirectMiddleware)\n",
    "\n",
    "## 4. Set Token Expiration\n",
    "\n",
    "# ❌ BAD - No expiration\n",
    "token = jwt.encode({\"user\": \"alice\"}, SECRET_KEY)\n",
    "\n",
    "# ✅ GOOD - Short expiration\n",
    "token = jwt.encode({\n",
    "    \"user\": \"alice\",\n",
    "    \"exp\": datetime.utcnow() + timedelta(hours=1)\n",
    "}, SECRET_KEY)\n",
    "\n",
    "## 5. Rate Limiting\n",
    "\n",
    "from slowapi import Limiter\n",
    "from slowapi.util import get_remote_address\n",
    "\n",
    "limiter = Limiter(key_func=get_remote_address)\n",
    "\n",
    "@app.post(\"/login\")\n",
    "@limiter.limit(\"5/minute\")\n",
    "async def login(request: Request):\n",
    "    # Prevent brute force attacks\n",
    "    pass\n",
    "\n",
    "## 6. Validate Input\n",
    "\n",
    "from pydantic import BaseModel, validator\n",
    "\n",
    "class LoginRequest(BaseModel):\n",
    "    username: str\n",
    "    password: str\n",
    "    \n",
    "    @validator('username')\n",
    "    def validate_username(cls, v):\n",
    "        if len(v) < 3:\n",
    "            raise ValueError('Username too short')\n",
    "        return v\n",
    "\n",
    "## 7. Implement Token Refresh\n",
    "\n",
    "@app.post(\"/token/refresh\")\n",
    "async def refresh_token(refresh_token: str):\n",
    "    # Verify refresh token\n",
    "    # Issue new access token\n",
    "    new_access_token = create_access_token(...)\n",
    "    return {\"access_token\": new_access_token}\n",
    "\n",
    "## 8. Log Authentication Events\n",
    "\n",
    "import logging\n",
    "logger = logging.getLogger(__name__)\n",
    "\n",
    "@app.post(\"/login\")\n",
    "async def login(username: str, password: str):\n",
    "    if authenticate(username, password):\n",
    "        logger.info(f\"Successful login: {username}\")\n",
    "    else:\n",
    "        logger.warning(f\"Failed login attempt: {username}\")\n",
    "\n",
    "## 9. Implement API Key Rotation\n",
    "\n",
    "class APIKey(BaseModel):\n",
    "    key: str\n",
    "    created_at: datetime\n",
    "    expires_at: datetime\n",
    "    \n",
    "    def is_expired(self) -> bool:\n",
    "        return datetime.utcnow() > self.expires_at\n",
    "\n",
    "@app.post(\"/api-keys/rotate\")\n",
    "async def rotate_api_key(old_key: str):\n",
    "    # Revoke old key\n",
    "    # Generate new key\n",
    "    new_key = generate_api_key()\n",
    "    return {\"api_key\": new_key}\n",
    "\n",
    "## 10. Use Security Headers\n",
    "\n",
    "from fastapi.middleware.cors import CORSMiddleware\n",
    "\n",
    "app.add_middleware(\n",
    "    CORSMiddleware,\n",
    "    allow_origins=[\"https://yourdomain.com\"],  # Not *\n",
    "    allow_credentials=True,\n",
    "    allow_methods=[\"GET\", \"POST\"],\n",
    "    allow_headers=[\"Authorization\"]\n",
    ")\n",
    "\n",
    "@app.middleware(\"http\")\n",
    "async def add_security_headers(request: Request, call_next):\n",
    "    response = await call_next(request)\n",
    "    response.headers[\"X-Content-Type-Options\"] = \"nosniff\"\n",
    "    response.headers[\"X-Frame-Options\"] = \"DENY\"\n",
    "    response.headers[\"X-XSS-Protection\"] = \"1; mode=block\"\n",
    "    return response\n",
    "\"\"\")"
   ]
