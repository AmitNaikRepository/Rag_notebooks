   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 👥 Role-Based Access Control (RBAC)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from enum import Enum\n",
    "from typing import List\n",
    "\n",
    "class Role(str, Enum):\n",
    "    USER = \"user\"\n",
    "    PRO = \"pro\"\n",
    "    ADMIN = \"admin\"\n",
    "\n",
    "class Permission(str, Enum):\n",
    "    READ = \"read\"\n",
    "    WRITE = \"write\"\n",
    "    DELETE = \"delete\"\n",
    "    ADMIN = \"admin\"\n",
    "\n",
    "# Role permissions mapping\n",
    "ROLE_PERMISSIONS = {\n",
    "    Role.USER: [Permission.READ],\n",
    "    Role.PRO: [Permission.READ, Permission.WRITE],\n",
    "    Role.ADMIN: [Permission.READ, Permission.WRITE, Permission.DELETE, Permission.ADMIN]\n",
    "}\n",
    "\n",
    "class UserWithRole(BaseModel):\n",
    "    username: str\n",
    "    role: Role\n",
    "    \n",
    "    def has_permission(self, permission: Permission) -> bool:\n",
    "        \"\"\"Check if user has permission.\"\"\"\n",
    "        return permission in ROLE_PERMISSIONS[self.role]\n",
    "\n",
    "def require_permission(permission: Permission):\n",
    "    \"\"\"Decorator to require specific permission.\"\"\"\n",
    "    \n",
    "    async def permission_checker(user: UserWithRole = Depends(get_current_user)):\n",
    "        if not user.has_permission(permission):\n",
    "            raise HTTPException(\n",
    "                status_code=403,\n",
    "                detail=f\"Permission denied. Required: {permission.value}\"\n",
    "            )\n",
    "        return user\n",
    "    \n",
    "    return permission_checker\n",
    "\n",
    "# Usage examples\n",
    "print(\"\"\"\n",
    "@app.get(\"/chat/history\")\n",
    "async def read_history(\n",
    "    user: UserWithRole = Depends(require_permission(Permission.READ))\n",
    "):\n",
    "    # Anyone with READ permission can access\n",
    "    return {\"messages\": [...]}\n",
    "\n",
    "@app.post(\"/chat/send\")\n",
    "async def send_message(\n",
    "    message: str,\n",
    "    user: UserWithRole = Depends(require_permission(Permission.WRITE))\n",
    "):\n",
    "    # Only PRO and ADMIN can write\n",
    "    return {\"status\": \"sent\"}\n",
    "\n",
    "@app.delete(\"/users/{user_id}\")\n",
    "async def delete_user(\n",
    "    user_id: str,\n",
    "    user: UserWithRole = Depends(require_permission(Permission.ADMIN))\n",
    "):\n",
    "    # Only ADMIN can delete\n",
    "    return {\"status\": \"deleted\"}\n",
    "\"\"\")\n",
    "\n",
    "print(\"\\n👥 RBAC Configuration\")\n",
    "print(\"\\nRole permissions:\")\n",
    "for role, perms in ROLE_PERMISSIONS.items():\n",
    "    print(f\"  {role.value}: {[p.value for p in perms]}\")"
   ]
  },
